# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=bobcourse
POSTGRES_PASSWORD=bobcourse
POSTGRES_DB=bobcourse_db

# ─── Python Core Service ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://bobcourse:bobcourse@localhost:5432/bobcourse_db

# JWT — MUST be changed in production. Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Java Analytics Service ───────────────────────────────────────────────────
ANALYTICS_SERVICE_URL=http://localhost:8080

# ─── Responsible AI ───────────────────────────────────────────────────────────
# Set to "offline" for demo (no API key needed) or "openai" for real analysis
AI_PROVIDER=offline
OPENAI_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173"]

# ─── Anonymity ────────────────────────────────────────────────────────────────
# Minimum number of responses before instructor can view evaluation results
MIN_RESPONSES_THRESHOLD=5
